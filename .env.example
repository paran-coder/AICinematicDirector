# Public app origin used for metadata and public first-frame URLs
NEXT_PUBLIC_APP_URL=https://ai-cinematic-director-eight.vercel.app
APP_URL=https://ai-cinematic-director-eight.vercel.app

# PostgreSQL. Vercel Marketplace Neon commonly provisions DATABASE_URL.
DATABASE_URL=
# Optional compatibility fallback when a provider exposes POSTGRES_URL instead.
POSTGRES_URL=

# Video provider: mock | higgsfield
VIDEO_PROVIDER=mock

# Server-only Higgsfield credentials. Never prefix these with NEXT_PUBLIC_.
HF_API_KEY_ID=
HF_API_KEY_SECRET=

# Explicit safety switch for paid live verification.
ALLOW_PAID_GENERATION=0
